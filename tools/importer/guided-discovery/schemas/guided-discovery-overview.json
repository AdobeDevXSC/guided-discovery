{
  "title": "Guided Discovery overview",
  "type": "object",
  "required": [
    "heading",
    "sections"
  ],
  "properties": {
    "eyebrow": {
      "type": "string",
      "title": "Eyebrow",
      "maxLength": 120
    },
    "heading": {
      "type": "string",
      "title": "Heading",
      "maxLength": 240
    },
    "intro": {
      "type": "string",
      "title": "Intro",
      "maxLength": 1200,
      "x-semantic-type": "long-text"
    },
    "benefitsHeading": {
      "type": "string",
      "title": "Benefits heading",
      "maxLength": 120
    },
    "benefits": {
      "type": "array",
      "title": "Benefits",
      "items": {
        "$ref": "#/$defs/Benefit"
      }
    },
    "turnsInto": {
      "type": "string",
      "title": "Outputs lead-in",
      "maxLength": 200
    },
    "outputs": {
      "type": "array",
      "title": "Outputs",
      "items": {
        "type": "string",
        "title": "Output",
        "maxLength": 160
      }
    },
    "sections": {
      "type": "array",
      "title": "Sections tracked for progress (in page order)",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "labels": {
      "type": "object",
      "title": "Labels",
      "properties": {
        "progressZero": {
          "type": "string",
          "title": "Heading before any section is complete",
          "maxLength": 120
        },
        "progressHeading": {
          "type": "string",
          "title": "Heading once a section is complete",
          "maxLength": 120
        },
        "progressCount": {
          "type": "string",
          "title": "Progress count (use {n} and {total})",
          "maxLength": 120
        },
        "start": {
          "type": "string",
          "title": "Start button",
          "maxLength": 80
        },
        "resume": {
          "type": "string",
          "title": "Continue button",
          "maxLength": 80
        },
        "done": {
          "type": "string",
          "title": "Summary button (all complete)",
          "maxLength": 120
        }
      }
    }
  },
  "$defs": {
    "Benefit": {
      "title": "Benefit",
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "title": "Title",
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "title": "Text",
          "maxLength": 600,
          "x-semantic-type": "long-text"
        },
        "accent": {
          "type": "string",
          "title": "Accent",
          "enum": [
            "analysis",
            "activation",
            "both"
          ],
          "default": "analysis"
        }
      }
    },
    "Section": {
      "title": "Section",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Section ID",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 80
        }
      }
    }
  }
}
