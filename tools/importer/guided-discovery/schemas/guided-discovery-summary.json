{
  "title": "Guided Discovery summary",
  "type": "object",
  "required": [
    "heading",
    "sections",
    "readinessFrom",
    "headlines",
    "sizes",
    "capabilities"
  ],
  "properties": {
    "heading": {
      "type": "string",
      "title": "Heading",
      "maxLength": 200
    },
    "intro": {
      "type": "string",
      "title": "Intro",
      "maxLength": 1200,
      "x-semantic-type": "long-text"
    },
    "sections": {
      "type": "array",
      "title": "Sections included (section IDs, in page order)",
      "minItems": 1,
      "items": {
        "type": "string",
        "title": "Section ID",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "readinessFrom": {
      "type": "string",
      "title": "Readiness: share of options picked in (sectionId.questionId)",
      "maxLength": 130,
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "labels": {
      "type": "object",
      "title": "Labels",
      "properties": {
        "submit": {
          "type": "string",
          "title": "Submit button",
          "maxLength": 80
        },
        "submitting": {
          "type": "string",
          "title": "Submitting label",
          "maxLength": 80
        },
        "download": {
          "type": "string",
          "title": "Download PDF button",
          "maxLength": 80
        },
        "snapshotHeading": {
          "type": "string",
          "title": "Snapshot heading",
          "maxLength": 120
        },
        "unlocksHeading": {
          "type": "string",
          "title": "Capabilities heading",
          "maxLength": 120
        },
        "engagementHeading": {
          "type": "string",
          "title": "Engagement heading",
          "maxLength": 120
        },
        "nextStepsHeading": {
          "type": "string",
          "title": "Next steps heading",
          "maxLength": 120
        },
        "teamHeading": {
          "type": "string",
          "title": "Team heading",
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "title": "Capability reason for a picked option (use {option} and {section})",
          "maxLength": 200
        },
        "thanksHeading": {
          "type": "string",
          "title": "Thanks heading",
          "maxLength": 120
        },
        "thanksText": {
          "type": "string",
          "title": "Thanks text",
          "maxLength": 600,
          "x-semantic-type": "long-text"
        },
        "empty": {
          "type": "string",
          "title": "Shown when nothing is answered yet",
          "maxLength": 300
        },
        "notSet": {
          "type": "string",
          "title": "Not set",
          "maxLength": 60
        },
        "error": {
          "type": "string",
          "title": "Submit error",
          "maxLength": 200
        },
        "reasonChoice": {
          "type": "string",
          "title": "Capability reason for a sorted item (use {option}, {choice} and {section})",
          "maxLength": 200
        },
        "reasonUpgrade": {
          "type": "string",
          "title": "Capability reason for a raised target (use {option} and {section})",
          "maxLength": 200
        },
        "readiness": {
          "type": "string",
          "title": "Readiness line (use {pct})",
          "maxLength": 120
        }
      }
    },
    "snapshot": {
      "type": "array",
      "title": "Snapshot rows",
      "items": {
        "$ref": "#/$defs/Row"
      }
    },
    "headlines": {
      "type": "array",
      "title": "Headlines (highest readiness first)",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Headline"
      }
    },
    "sizes": {
      "type": "array",
      "title": "Engagement sizes (checked in order; the last is the default)",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Size"
      }
    },
    "sizeNote": {
      "type": "string",
      "title": "Engagement note",
      "maxLength": 300
    },
    "capabilities": {
      "type": "array",
      "title": "Capabilities",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "contacts": {
      "type": "array",
      "title": "Your Adobe team",
      "items": {
        "$ref": "#/$defs/Contact"
      }
    },
    "links": {
      "type": "array",
      "title": "Links after submitting",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "disclaimer": {
      "type": "string",
      "title": "Disclaimer",
      "maxLength": 800,
      "x-semantic-type": "long-text"
    }
  },
  "$defs": {
    "Row": {
      "title": "Snapshot row",
      "type": "object",
      "required": [
        "label",
        "source",
        "show"
      ],
      "properties": {
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "title": "Source (sectionId.questionId, or sectionId for answered-count)",
          "maxLength": 130,
          "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)?$"
        },
        "show": {
          "type": "string",
          "title": "Show",
          "enum": [
            "answer",
            "count",
            "choice-count",
            "owner-count",
            "answered-count"
          ]
        },
        "choice": {
          "type": "string",
          "title": "Choice ID (choice-count)",
          "maxLength": 64
        },
        "template": {
          "type": "string",
          "title": "Text (use {n} and {total})",
          "maxLength": 200
        }
      }
    },
    "Headline": {
      "title": "Headline",
      "type": "object",
      "required": [
        "id",
        "label",
        "minReadiness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "ID",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 120
        },
        "minReadiness": {
          "type": "number",
          "title": "Minimum readiness (0 to 1)",
          "minimum": 0,
          "maximum": 1
        },
        "steps": {
          "type": "array",
          "title": "Recommended next steps",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      }
    },
    "Step": {
      "title": "Step",
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "title": "Title",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "title": "Text",
          "maxLength": 600,
          "x-semantic-type": "long-text"
        }
      }
    },
    "Size": {
      "title": "Size",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "ID",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 60
        },
        "duration": {
          "type": "string",
          "title": "Duration",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "title": "Model",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "title": "Title",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "title": "Text",
          "maxLength": 800,
          "x-semantic-type": "long-text"
        },
        "maxCapabilities": {
          "type": "integer",
          "title": "Rule: at most this many capabilities",
          "minimum": 0
        },
        "maxReadiness": {
          "type": "number",
          "title": "Rule: readiness below",
          "minimum": 0,
          "maximum": 1
        },
        "match": {
          "type": "string",
          "title": "Rule: match",
          "enum": [
            "all",
            "any"
          ],
          "default": "all"
        }
      }
    },
    "Capability": {
      "title": "Capability",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "ID",
          "enum": [
            "connected-data",
            "graph-stitching",
            "data-transformations",
            "journey-mapping",
            "attribution",
            "experimentation",
            "ai-capabilities",
            "content-analytics"
          ]
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "title": "Description",
          "maxLength": 600,
          "x-semantic-type": "long-text"
        }
      }
    },
    "Contact": {
      "title": "Contact",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "title": "Role",
          "maxLength": 200
        }
      }
    },
    "Link": {
      "title": "Link",
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "title": "URL",
          "maxLength": 500,
          "pattern": "^https://"
        }
      }
    }
  }
}
