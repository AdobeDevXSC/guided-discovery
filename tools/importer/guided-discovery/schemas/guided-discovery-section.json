{
  "title": "Guided Discovery section",
  "type": "object",
  "required": [
    "sectionId",
    "heading",
    "questions"
  ],
  "properties": {
    "sectionId": {
      "type": "string",
      "title": "Section ID",
      "description": "Stable key for this section (e.g. discovery). Answers are stored under it; do not change after launch.",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64
    },
    "eyebrow": {
      "type": "string",
      "title": "Eyebrow",
      "maxLength": 120
    },
    "heading": {
      "type": "string",
      "title": "Heading",
      "maxLength": 200
    },
    "intro": {
      "type": "string",
      "title": "Intro",
      "maxLength": 1200,
      "x-semantic-type": "long-text"
    },
    "hint": {
      "type": "string",
      "title": "Hint shown above Continue",
      "maxLength": 400,
      "x-semantic-type": "long-text"
    },
    "continueText": {
      "type": "string",
      "title": "Text next to Continue",
      "maxLength": 300
    },
    "continueLabel": {
      "type": "string",
      "title": "Continue button label",
      "maxLength": 60,
      "default": "Continue →"
    },
    "completedLabel": {
      "type": "string",
      "title": "Label once the section is complete",
      "maxLength": 60,
      "default": "Section complete"
    },
    "focusFrom": {
      "type": "string",
      "title": "Focus comes from (sectionId.questionId)",
      "description": "Optional. Questions and options whose bucket matches this answer come first, e.g. discovery.focus.",
      "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)?$",
      "maxLength": 130
    },
    "labels": {
      "type": "object",
      "title": "Guided flow labels",
      "properties": {
        "startHeading": {
          "type": "string",
          "title": "Start card heading",
          "maxLength": 120,
          "default": "Ready when you are"
        },
        "start": {
          "type": "string",
          "title": "Start button",
          "maxLength": 120,
          "default": "Start →"
        },
        "resume": {
          "type": "string",
          "title": "Resume button",
          "maxLength": 120,
          "default": "Continue →"
        },
        "next": {
          "type": "string",
          "title": "Next button",
          "maxLength": 120,
          "default": "Next →"
        },
        "back": {
          "type": "string",
          "title": "Back button",
          "maxLength": 120,
          "default": "← Back"
        },
        "done": {
          "type": "string",
          "title": "Done button",
          "maxLength": 120,
          "default": "Done"
        },
        "questionCount": {
          "type": "string",
          "title": "Step progress (use {n} and {total})",
          "maxLength": 120,
          "default": "Question {n} of {total}"
        },
        "selectOne": {
          "type": "string",
          "title": "Hint for single choice",
          "maxLength": 120,
          "default": "Select one"
        },
        "selectAll": {
          "type": "string",
          "title": "Hint for multiple choice",
          "maxLength": 120,
          "default": "Select all that apply"
        },
        "swipeHint": {
          "type": "string",
          "title": "Swipe instructions",
          "maxLength": 120,
          "default": "Swipe left (or tap ✕) for no - right (or tap ✓) for yes."
        },
        "swipeCount": {
          "type": "string",
          "title": "Swipe progress (use {n} and {total})",
          "maxLength": 120,
          "default": "{n} of {total}"
        },
        "optionalCount": {
          "type": "string",
          "title": "Optional extra count (use {n})",
          "maxLength": 120,
          "default": "{n} more, optional"
        },
        "sliderHint": {
          "type": "string",
          "title": "Slider hint",
          "maxLength": 120,
          "default": "Drag to answer, or tap a point on the line"
        },
        "yes": {
          "type": "string",
          "title": "Yes button label (screen readers)",
          "maxLength": 120,
          "default": "Yes"
        },
        "no": {
          "type": "string",
          "title": "No button label (screen readers)",
          "maxLength": 120,
          "default": "No"
        },
        "close": {
          "type": "string",
          "title": "Close button label (screen readers)",
          "maxLength": 120,
          "default": "Close"
        },
        "search": {
          "type": "string",
          "title": "Inventory: search placeholder",
          "maxLength": 160,
          "default": "Search implementation elements..."
        },
        "allCategories": {
          "type": "string",
          "title": "Inventory: all categories",
          "maxLength": 160,
          "default": "All categories"
        },
        "allComplexity": {
          "type": "string",
          "title": "Inventory: all complexity levels",
          "maxLength": 160,
          "default": "All complexity levels"
        },
        "complexityLow": {
          "type": "string",
          "title": "Complexity: low",
          "maxLength": 160,
          "default": "Low complexity"
        },
        "complexityMedium": {
          "type": "string",
          "title": "Complexity: medium",
          "maxLength": 160,
          "default": "Medium complexity"
        },
        "complexityHigh": {
          "type": "string",
          "title": "Complexity: high",
          "maxLength": 160,
          "default": "High complexity"
        },
        "allBuckets": {
          "type": "string",
          "title": "Inventory: all needs",
          "maxLength": 160,
          "default": "All needs (analysis + activation)"
        },
        "bucketAnalysisFilter": {
          "type": "string",
          "title": "Inventory: analysis filter",
          "maxLength": 160,
          "default": "Data Analysis focus"
        },
        "bucketActivationFilter": {
          "type": "string",
          "title": "Inventory: activation filter",
          "maxLength": 160,
          "default": "Data Activation focus"
        },
        "bucketAnalysis": {
          "type": "string",
          "title": "Bucket chip: analysis",
          "maxLength": 160,
          "default": "Analysis"
        },
        "bucketActivation": {
          "type": "string",
          "title": "Bucket chip: activation",
          "maxLength": 160,
          "default": "Activation"
        },
        "bucketBoth": {
          "type": "string",
          "title": "Bucket chip: both",
          "maxLength": 160,
          "default": "Analysis + Activation"
        },
        "resultCount": {
          "type": "string",
          "title": "Inventory: result count (use {n} and {total})",
          "maxLength": 160,
          "default": "{n} of {total}"
        },
        "noMatches": {
          "type": "string",
          "title": "Inventory: no matches",
          "maxLength": 160,
          "default": "No matches. Try a different search or filter."
        },
        "itemCount": {
          "type": "string",
          "title": "Per-item progress (use {n} and {total})",
          "maxLength": 160,
          "default": "Item {n} of {total}"
        },
        "mappingFrom": {
          "type": "string",
          "title": "Mapping card: from",
          "maxLength": 160,
          "default": "Adobe Analytics"
        },
        "mappingTo": {
          "type": "string",
          "title": "Mapping card: to",
          "maxLength": 160,
          "default": "Customer Journey Analytics"
        },
        "mappingWhy": {
          "type": "string",
          "title": "Mapping card: why",
          "maxLength": 160,
          "default": "Why:"
        },
        "mappingPrereqs": {
          "type": "string",
          "title": "Mapping card: prerequisites",
          "maxLength": 160,
          "default": "Prerequisites:"
        },
        "perItemEmpty": {
          "type": "string",
          "title": "Per-item: nothing selected yet",
          "maxLength": 160,
          "default": "Select items above to see them here."
        },
        "ownerLabel": {
          "type": "string",
          "title": "Owner cards: owner field label",
          "maxLength": 160,
          "default": "Owner today"
        },
        "ownerPlaceholder": {
          "type": "string",
          "title": "Owner cards: owner placeholder",
          "maxLength": 160,
          "default": "Name or team"
        },
        "followUp": {
          "type": "string",
          "title": "Owner cards: follow-up checkbox",
          "maxLength": 160,
          "default": "Needs a follow-up conversation"
        },
        "relevantTag": {
          "type": "string",
          "title": "Tag on options matching the focus",
          "maxLength": 160,
          "default": "Most relevant to your focus"
        },
        "roleCount": {
          "type": "string",
          "title": "Owner cards: guided progress (use {n} and {total})",
          "maxLength": 160,
          "default": "Role {n} of {total}"
        },
        "sortHint": {
          "type": "string",
          "title": "Sort: swipe instructions",
          "maxLength": 160,
          "default": "Swipe left (or ✕) if it's a gap for you, right (or ✓) if it's already in place."
        }
      }
    },
    "questions": {
      "type": "array",
      "title": "Questions",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Question"
      }
    }
  },
  "$defs": {
    "Question": {
      "title": "Question",
      "type": "object",
      "required": [
        "id",
        "display",
        "title"
      ],
      "properties": {
        "groupHeading": {
          "type": "string",
          "title": "Step title / heading above this question",
          "description": "Starts a new step in the guided flow (and a heading on the page), e.g. \"A few questions to start\".",
          "maxLength": 200
        },
        "id": {
          "type": "string",
          "title": "Question ID",
          "description": "Stable key for the answer (e.g. pain). Do not change after launch.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "display": {
          "type": "string",
          "title": "Display",
          "description": "cards = large cards (a single-choice cards question opens the guided flow as its first screen); chips = tiles; swipe = one option at a time, yes/no; slider = a track across the first N options (the rest become chips like \"Don't know\"). inventory = a filterable, searchable card grid (a swipe in the guided flow); per-item = asks \"choices\" about each option picked in the \"itemsFrom\" question. sort = puts each option into one of two choices (swipe right = first choice, left = second); owner-cards = a card per option with its fields, an owner text box and a follow-up checkbox.",
          "enum": [
            "cards-single",
            "cards-multi",
            "chips-single",
            "chips-multi",
            "swipe",
            "slider",
            "inventory",
            "per-item",
            "sort",
            "owner-cards"
          ]
        },
        "sliderStops": {
          "type": "integer",
          "title": "Slider: number of stops",
          "description": "Slider only. The first N options become points on the track; any remaining options are shown as separate chips.",
          "minimum": 2,
          "maximum": 10
        },
        "gauge": {
          "type": "string",
          "title": "Slider: gauge graphic",
          "enum": [
            "none",
            "journey",
            "clock",
            "signal"
          ],
          "default": "none"
        },
        "firstForFocus": {
          "type": "string",
          "title": "Ask this question first when the focus is",
          "enum": [
            "analysis",
            "activation"
          ]
        },
        "bucket": {
          "type": "string",
          "title": "Question bucket (ordering by focus)",
          "enum": [
            "analysis",
            "activation",
            "both"
          ]
        },
        "differentFrom": {
          "type": "string",
          "title": "Slider: must differ from question ID",
          "description": "Optional. Picking the same stop clears the other question (e.g. today vs target).",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "upgradeFrom": {
          "type": "string",
          "title": "Slider: compare with question ID",
          "description": "Optional. When this answer is further along the track than that question, the capabilities below are recommended.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "upgradeCapabilities": {
          "type": "array",
          "title": "Slider: capabilities when further along",
          "items": {
            "type": "string",
            "title": "Capability",
            "enum": [
              "connected-data",
              "graph-stitching",
              "data-transformations",
              "journey-mapping",
              "attribution",
              "experimentation",
              "ai-capabilities",
              "content-analytics"
            ]
          }
        },
        "noteLabel": {
          "type": "string",
          "title": "Label for option notes (e.g. CJA logic:)",
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "title": "Question text",
          "maxLength": 300
        },
        "guidedTitle": {
          "type": "string",
          "title": "Title in the guided flow",
          "description": "Optional. Overrides the question text as the overlay title (e.g. \"What you track\").",
          "maxLength": 200
        },
        "help": {
          "type": "string",
          "title": "Help text",
          "maxLength": 400
        },
        "required": {
          "type": "boolean",
          "title": "Required to continue",
          "default": false
        },
        "options": {
          "type": "array",
          "title": "Options",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "itemsFrom": {
          "type": "string",
          "title": "Per-item: question ID whose picked options are the items",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "choices": {
          "type": "array",
          "title": "Per-item: choices asked for each item",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "filterByQuestion": {
          "type": "string",
          "title": "Filter options by the answer to question ID",
          "description": "Optional. Options whose Focus bucket matches that answer come first (\"both\" always matches). Use sectionId.questionId for another section, e.g. discovery.focus.",
          "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)?$",
          "maxLength": 130
        },
        "outsideTitle": {
          "type": "string",
          "title": "Swipe: title for options outside the focus",
          "maxLength": 120
        },
        "outsideMessage": {
          "type": "string",
          "title": "Swipe: message offering options outside the focus",
          "maxLength": 400
        }
      }
    },
    "Option": {
      "title": "Option",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Option ID",
          "description": "Stable key saved when this option is picked. Do not change after launch.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 200
        },
        "tag": {
          "type": "string",
          "title": "Tag (small label on swipe cards)",
          "maxLength": 60
        },
        "subLabel": {
          "type": "string",
          "title": "Sub-label (e.g. eVar · Commerce)",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "title": "Category (inventory filter)",
          "maxLength": 60
        },
        "complexity": {
          "type": "string",
          "title": "Complexity",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "tier": {
          "type": "string",
          "title": "Tier badge (e.g. Foundation)",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "title": "Description",
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "title": "Note (shown expandable, e.g. CJA logic)",
          "maxLength": 800,
          "x-semantic-type": "long-text"
        },
        "fields": {
          "type": "array",
          "title": "Owner cards: detail fields",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "caption": {
          "type": "string",
          "title": "Caption shown when selected",
          "maxLength": 300
        },
        "bucket": {
          "type": "string",
          "title": "Focus bucket",
          "description": "For focus filtering: analysis, activation or both.",
          "enum": [
            "analysis",
            "activation",
            "both"
          ]
        },
        "capabilities": {
          "type": "array",
          "title": "Unlocks CJA capabilities",
          "description": "Picking this option recommends these capabilities on the summary.",
          "items": {
            "type": "string",
            "title": "Capability",
            "enum": [
              "connected-data",
              "graph-stitching",
              "data-transformations",
              "journey-mapping",
              "attribution",
              "experimentation",
              "ai-capabilities",
              "content-analytics"
            ]
          }
        },
        "mapping": {
          "type": "object",
          "title": "Mapping details (shown by per-item questions)",
          "properties": {
            "target": {
              "type": "string",
              "title": "Target approach",
              "maxLength": 300
            },
            "field": {
              "type": "string",
              "title": "Field path",
              "maxLength": 200
            },
            "why": {
              "type": "string",
              "title": "Why",
              "maxLength": 800,
              "x-semantic-type": "long-text"
            },
            "prereqs": {
              "type": "array",
              "title": "Prerequisites",
              "items": {
                "type": "string",
                "title": "Prerequisite",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "Choice": {
      "title": "Choice",
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Choice ID",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 120
        },
        "capabilities": {
          "type": "array",
          "title": "Unlocks CJA capabilities when chosen",
          "items": {
            "type": "string",
            "title": "Capability",
            "enum": [
              "connected-data",
              "graph-stitching",
              "data-transformations",
              "journey-mapping",
              "attribution",
              "experimentation",
              "ai-capabilities",
              "content-analytics"
            ]
          }
        }
      }
    },
    "Field": {
      "title": "Field",
      "type": "object",
      "required": [
        "label",
        "text"
      ],
      "properties": {
        "label": {
          "type": "string",
          "title": "Label",
          "maxLength": 60
        },
        "text": {
          "type": "string",
          "title": "Text",
          "maxLength": 600,
          "x-semantic-type": "long-text"
        }
      }
    }
  }
}
