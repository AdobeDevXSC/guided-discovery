{
  "metadata": {
    "projectType": "da"
  },
  "templates": [
    {
      "name": "acs",
      "urls": [
        "https://landing.adobe.com/acs/analytics-modernization-readiness.html"
      ],
      "representativeUrl": "https://landing.adobe.com/acs/analytics-modernization-readiness.html",
      "description": "ACS campaign landing page: dark split hero, light stats band, centered intro with feature cards, black closing CTA. Sections #how-it-works and #discovery are in-page anchor targets.",
      "urlPattern": "/acs/*",
      "blocks": [
        {
          "name": "columns-hero",
          "instances": [
            "main > section.hero > .wrap",
            "section.hero .wrap"
          ]
        },
        {
          "name": "cards-stats",
          "instances": [
            ".stats-band .stats-grid",
            "#stats-section .stats-grid"
          ]
        },
        {
          "name": "cards-feature",
          "instances": [
            "#how-it-works .feature-row",
            "section .feature-row"
          ]
        }
      ],
      "sections": [
        {
          "id": "rc1",
          "name": "hero",
          "selector": [
            "main > section.hero",
            "section.hero"
          ],
          "style": "dark",
          "blocks": [
            "columns-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "rc2",
          "name": "stats",
          "selector": [
            ".stats-band",
            "#stats-section"
          ],
          "style": "light",
          "blocks": [
            "cards-stats"
          ],
          "defaultContent": []
        },
        {
          "id": "rc3",
          "name": "how-it-works",
          "selector": [
            "#how-it-works",
            "main > section:has(.feature-row)"
          ],
          "style": "center",
          "blocks": [
            "cards-feature"
          ],
          "defaultContent": [
            ".intro-head h2",
            ".intro-head p"
          ]
        },
        {
          "id": "rc4",
          "name": "discovery",
          "selector": [
            "section.closing",
            "#discovery"
          ],
          "style": "black, center",
          "blocks": [],
          "defaultContent": [
            "section.closing h2",
            "section.closing a.btn"
          ]
        }
      ]
    }
  ]
}
